# Copia este archivo como .env para compilar en local con otros valores.
PUBLIC_SITE_URL=https://mitru-constructor.vercel.app
# true = Google puede indexar. Déjalo en false mientras haya datos provisionales.
PUBLIC_INDEXABLE=false
# formsubmit | netlify | none
PUBLIC_FORM_PROVIDER=formsubmit
# Tras activar FormSubmit puedes poner aquí el alias aleatorio que te envían por correo.
PUBLIC_FORMSUBMIT_TARGET=orzamitru20@gmail.com
# Código de verificación de Google Search Console (método "etiqueta HTML").
PUBLIC_GSC_VERIFICATION=
