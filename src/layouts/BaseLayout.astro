---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/bitter/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickActions from '../components/QuickActions.astro';
import { t, routes, langs, hreflang, defaultLang, type Lang, type PageKey } from '../i18n';
import { site } from '../config/site';

interface Props {
  lang: Lang;
  pageKey: PageKey;
  title: string;
  description: string;
  /** Fuerza noindex en esta página (p. ej. textos legales provisionales). */
  noindex?: boolean;
  jsonLd?: object[];
  /** Si las anclas del menú apuntan a esta misma página (solo en la portada). */
  onHome?: boolean;
}
const { lang, pageKey, title, description, noindex = false, jsonLd = [], onHome = pageKey === 'home' } = Astro.props;
const d = t(lang);
const abs = (path: string) => new URL(path, site.url).href;
const canonical = abs(routes[lang][pageKey]);
const ogImage = abs(`/og/og-${lang}.png`);
const robots = !site.indexable || noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const gscToken = import.meta.env.PUBLIC_GSC_VERIFICATION as string | undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={hreflang[l]} href={abs(routes[l][pageKey])} />)}
    <link rel="alternate" hreflang="x-default" href={abs(routes[defaultLang][pageKey])} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta property="og:locale" content={d.locale} />
    {
      langs
        .filter((l) => l !== lang)
        .map((l) => <meta property="og:locale:alternate" content={t(l).locale} />)
    }
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#f7f4ee" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {gscToken && <meta name="google-site-verification" content={gscToken} />}

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{d.nav.skip}</a>
    <Header lang={lang} pageKey={pageKey} onHome={onHome} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} onHome={onHome} />
    <QuickActions lang={lang} onHome={onHome} />

    <script>
      // Revelado progresivo al hacer scroll. Lo que ya está en pantalla aparece al momento.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.01 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
