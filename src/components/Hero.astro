---
import Icon from './Icon.astro';
import HeroIllustration from './HeroIllustration.astro';
import type { Dict } from '../i18n/es';

interface Props {
  d: Dict;
}
const { d } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">{d.hero.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">
        {d.hero.lines.map((line, i) => <span class="hero__line" style={`--i:${i}`}>{line} </span>)}
      </h1>
      <p class="hero__sub">{d.hero.sub}</p>
      <div class="hero__ctas">
        <a class="btn btn-primary" href="#contacto">
          {d.hero.ctaPrimary}
          <Icon name="arrow" class="btn-arrow" />
        </a>
        <a class="btn btn-secondary" href="#servicios">{d.hero.ctaSecondary}</a>
      </div>
      <ul class="hero__facts">
        {
          d.hero.facts.map((f) => (
            <li>
              <strong>{f.strong}</strong>
              <span>{f.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hero__visual">
      <HeroIllustration d={d} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(3.5rem, 2rem + 5vw, 6rem);
    overflow: hidden;
  }
  .hero::before {
    /* Banda de color suave tras la ilustración */
    content: '';
    position: absolute;
    inset: 0 0 0 55%;
    background: linear-gradient(180deg, var(--color-paper-200), var(--color-paper-100));
    z-index: -1;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
  }
  .hero__eyebrow {
    display: inline-block;
    margin-bottom: var(--space-5);
    padding: 0.4rem 0.85rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-accent-strong);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent-tint);
    border-radius: var(--radius-full);
  }
  .hero__title {
    font-size: clamp(2.3rem, 0.9rem + 4vw, 4.4rem);
    font-weight: 850;
    font-stretch: 112%;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: initial;
  }
  .hero__line {
    display: block;
  }
  .hero__line:last-child {
    color: var(--color-brand-strong);
  }
  .hero__sub {
    max-width: 36rem;
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    max-width: 34rem;
    margin: var(--space-10) 0 0;
    padding: var(--space-5) 0 0;
    list-style: none;
    border-top: 1px solid var(--color-border-strong);
  }
  .hero__facts li {
    display: grid;
    gap: 2px;
  }
  .hero__facts strong {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.7rem);
    font-weight: 850;
    line-height: 1.1;
  }
  .hero__facts span {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.35;
  }

  /* Entrada: revelado por líneas (Text Clip-Path Reveal) — sin JS */
  @media (prefers-reduced-motion: no-preference) {
    .hero__line {
      clip-path: inset(-0.1em 100% -0.2em 0);
      animation: line-reveal 760ms var(--ease-out) calc(120ms + var(--i) * 170ms) forwards;
    }
    .hero__eyebrow,
    .hero__sub,
    .hero__ctas,
    .hero__facts {
      opacity: 0;
      animation: fade-up 600ms var(--ease-out) forwards;
    }
    .hero__eyebrow {
      animation-delay: 40ms;
    }
    .hero__sub {
      animation-delay: 600ms;
    }
    .hero__ctas {
      animation-delay: 720ms;
    }
    .hero__facts {
      animation-delay: 860ms;
    }
  }
  @keyframes line-reveal {
    to {
      clip-path: inset(-0.1em -1em -0.2em 0);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 959px) {
    /* En móvil el titular fluye como un párrafo y entra con un fundido. */
    .hero__line {
      display: inline;
      clip-path: none !important;
      animation: none !important;
    }
    .hero__title {
      text-wrap: balance;
      opacity: 0;
      animation: fade-up 600ms var(--ease-out) 100ms forwards;
    }
    .hero::before {
      inset: 58% 0 0 0;
    }
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      max-width: 560px;
      width: 100%;
      margin-inline: auto;
    }
  }
  @media (max-width: 480px) {
    .hero__ctas .btn {
      width: 100%;
    }
    .hero__facts {
      gap: var(--space-3);
    }
  }
</style>
