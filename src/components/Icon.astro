  menu: ['M4 7h16M4 12h16M4 17h16'],
  close: ['M6 6l12 12M18 6 6 18'],
  globe: ['M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z', 'M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18'],
  chevron: ['M6 9l6 6 6-6'],
  plus: ['M12 5v14M5 12h14'],
  store: ['M4 9l1.5-5h13L20 9', 'M4 9v11h16V9M4 9h16', 'M9 20v-6h6v6'],
  bed: ['M3 18V7', 'M3 13h18v5', 'M21 15.5V15a3 3 0 0 0-3-3h-7v1', 'M6.5 12a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z'],
  hardhat: ['M3 17h18v2.5H3z', 'M5 17a7 7 0 0 1 14 0', 'M10 10.5V6h4v4.5'],
  shield: ['M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z', 'M8.5 12l2.5 2.5 4.5-5'],
