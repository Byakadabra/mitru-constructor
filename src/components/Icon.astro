  layers: ['M3 7l9-4 9 4-9 4z', 'M3 12l9 4 9-4', 'M3 17l9 4 9-4'],
} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
  size?: number;
}
const { name, class: className, label, size = 24 } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
