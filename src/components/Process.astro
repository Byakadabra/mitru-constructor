---
/**
 * "Cómo trabajamos": a la izquierda los 5 pasos; a la derecha una casa isométrica que se va
 * construyendo según el paso visible (parcela → plano → cimientos → paredes e instalaciones →
 * tejado y luces). La geometría isométrica se calcula aquí, en el build (SVG puro, sin librerías).
 */
import type { Dict } from '../i18n/es';
interface Props {
  d: Dict;
}
const { d } = Astro.props;

// Proyección isométrica real: ejes del suelo a ±30°.
const S = 34;
const OX = 238;
const OY = 150;
type V3 = [number, number, number];
const iso = ([x, y, z]: V3) => [(x - y) * 0.866 * S + OX, (x + y) * 0.5 * S - z * S + OY];
const poly = (pts: V3[]) =>
  pts
    .map(iso)
    .map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`)
    .join(' ');
const pt = (p: V3) => iso(p).map((n) => n.toFixed(1));
// Caja: cara superior (clara), cara +y (media, izquierda), cara +x (oscura, derecha)
const box = (x0: number, x1: number, y0: number, y1: number, z0: number, z1: number) => ({
  top: poly([[x0, y0, z1], [x1, y0, z1], [x1, y1, z1], [x0, y1, z1]]),
  left: poly([[x0, y1, z0], [x1, y1, z0], [x1, y1, z1], [x0, y1, z1]]),
  right: poly([[x1, y0, z0], [x1, y1, z0], [x1, y1, z1], [x1, y0, z1]]),
});

const ground = box(0, 7, 0, 7, -0.45, 0);
const plan = poly([[1.2, 1.2, 0.02], [5.6, 1.2, 0.02], [5.6, 5.0, 0.02], [1.2, 5.0, 0.02]]);
const found = box(1.2, 5.6, 1.2, 5.0, 0, 0.35);
const walls = box(1.35, 5.45, 1.35, 4.85, 0.35, 2.7);
// Ventanas y puerta (sobre las caras visibles)
const winR = [1.9, 3.4].map((y) => poly([[5.46, y, 1.3], [5.46, y + 0.9, 1.3], [5.46, y + 0.9, 2.2], [5.46, y, 2.2]]));
const winL = [1.8].map((x) => poly([[x, 4.86, 1.3], [x + 0.9, 4.86, 1.3], [x + 0.9, 4.86, 2.2], [x, 4.86, 2.2]]));
const door = poly([[3.6, 4.86, 0.35], [4.4, 4.86, 0.35], [4.4, 4.86, 1.95], [3.6, 4.86, 1.95]]);
// Instalaciones: cable eléctrico (cara derecha) y tubería (cara izquierda)
const line = (pts: V3[]) => pts.map((p) => pt(p).join(',')).join(' ');
const wire = line([
  [5.47, 1.55, 0.6],
  [5.47, 1.55, 2.45],
  [5.47, 4.6, 2.45],
  [5.47, 4.6, 1.0],
]);
const pipe = line([
  [1.6, 4.87, 0.45],
  [3.2, 4.87, 0.45],
  [3.2, 4.87, 2.4],
]);
// Tejado a dos aguas con cumbrera en X
const ze = 2.7;
const zr = 4.3;
const yr = 3.1;
const roofFront = poly([[1.0, yr, zr], [5.85, yr, zr], [5.85, 5.25, ze], [1.0, 5.25, ze]]);
const roofBack = poly([[1.0, 0.95, ze], [5.85, 0.95, ze], [5.85, yr, zr], [1.0, yr, zr]]);
const roofEdge = poly([
  [5.85, 0.95, ze],
  [5.85, yr, zr],
  [5.85, 5.25, ze],
  [5.85, 5.25, ze - 0.22],
  [5.85, yr, zr - 0.22],
  [5.85, 0.95, ze - 0.22],
]);
const gableEnd = poly([[5.45, 1.35, ze], [5.45, 4.85, ze], [5.45, yr, zr - 0.2]]);
const chim = box(2.1, 2.6, 2.0, 2.5, 3.4, 4.7);
const tree = pt([0.6, 6.3, 0]);
const pin = pt([3.4, 3.1, 1.2]);
const doc = pt([1.0, 5.6, 2.6]);
const dimA = pt([1.2, 5.45, 0.02]);
const dimB = pt([5.6, 5.45, 0.02]);
---

<section id="proceso" class="section process" aria-labelledby="process-title">
  <div class="container process__inner">
    <div class="process__copy">
      <div class="section-head" data-reveal="left">
        <h2 id="process-title">{d.process.title}</h2>
        <p>{d.process.intro}</p>
      </div>
      <ol class="steps">
        {
          d.process.steps.map((s, i) => (
            <li class="step" data-step={i + 1} data-reveal="right" style={`--i:${i}`}>
              <span class="step__num" aria-hidden="true">
                {i + 1}
              </span>
              <div>
                <h3>
                  <span class="visually-hidden">{i + 1}. </span>
                  {s.title}
                </h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="process__scene">
      <svg class="iso" viewBox="0 0 476 420" role="img" aria-label={d.process.title} data-iso data-stage="5">
        <!-- 1. Parcela -->
        <g class="iso-g" data-s="1">
          <polygon class="g-top" points={ground.top}></polygon>
          <polygon class="g-left" points={ground.left}></polygon>
          <polygon class="g-right" points={ground.right}></polygon>
        </g>
        <!-- 2. Plano del encargo -->
        <g class="iso-g" data-s="2">
          <polygon class="plan" points={plan}></polygon>
        </g>
        <!-- 3. Valoración: cimientos + cota -->
        <g class="iso-g" data-s="3">
          <polygon class="c-top" points={found.top}></polygon>
          <polygon class="c-left" points={found.left}></polygon>
          <polygon class="c-right" points={found.right}></polygon>
          <line class="dim" x1={dimA[0]} y1={dimA[1]} x2={dimB[0]} y2={dimB[1]}></line>
        </g>
        <!-- 4. Presupuesto aceptado: paredes, ventanas e instalaciones -->
        <g class="iso-g" data-s="4">
          <polygon class="w-left" points={walls.left}></polygon>
          <polygon class="w-right" points={walls.right}></polygon>
          {winR.map((w) => <polygon class="win" points={w} />)}
          {winL.map((w) => <polygon class="win" points={w} />)}
          <polygon class="door" points={door}></polygon>
          <polyline class="wire" points={wire}></polyline>
          <polyline class="pipe" points={pipe}></polyline>
        </g>
        <!-- 5. Ejecución: tejado, chimenea, luces y jardín -->
        <g class="iso-g" data-s="5">
          <polygon class="r-back" points={roofBack}></polygon>
          <polygon class="gable" points={gableEnd}></polygon>
          <polygon class="ch-top" points={chim.top}></polygon>
          <polygon class="ch-left" points={chim.left}></polygon>
          <polygon class="ch-right" points={chim.right}></polygon>
          <polygon class="r-front" points={roofFront}></polygon>
          <polygon class="r-edge" points={roofEdge}></polygon>
          <g transform={`translate(${tree[0]} ${tree[1]})`}>
            <rect x="-4" y="-26" width="8" height="26" rx="2" class="trunk"></rect>
            <circle cx="0" cy="-42" r="22" class="leaf"></circle>
            <circle cx="-8" cy="-50" r="8" class="leaf-hi"></circle>
          </g>
        </g>
        <!-- Indicadores de paso: llamada (1-2) y presupuesto aceptado (4) -->
        <g class="iso-pin" transform={`translate(${pin[0]} ${pin[1]})`}>
          <g class="bob">
            <path d="M0 0c-14-16-22-26-22-38a22 22 0 0 1 44 0c0 12-8 22-22 38z" class="pin-body"></path>
            <path
              d="M-8 -48h5l2 6-3 2a12 12 0 0 0 6 6l2-3 6 2v5a3 3 0 0 1-3 3 20 20 0 0 1-18-18 3 3 0 0 1 3-3z"
              class="pin-icon"></path>
          </g>
        </g>
        <g class="iso-doc" transform={`translate(${doc[0]} ${doc[1]})`}>
          <g class="bob">
            <rect x="-26" y="-34" width="52" height="64" rx="6" class="doc-paper"></rect>
            <path d="M-14 -18h28M-14 -8h28M-14 2h18" class="doc-lines"></path>
            <circle cx="16" cy="22" r="13" class="doc-check-bg"></circle>
            <path d="M10 22l4 4 8-8" class="doc-check"></path>
          </g>
        </g>
      </svg>
    </div>
  </div>
</section>

<script>
  // La casa avanza hasta el paso que está en el centro de la pantalla (también hacia atrás).
  const scene = document.querySelector<SVGSVGElement>('[data-iso]');
  const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
  if (scene && steps.length && 'IntersectionObserver' in window) {
    const groups = [...scene.querySelectorAll<SVGGElement>('[data-s]')];
    const setStage = (n: number) => {
      scene.dataset.stage = String(n);
      groups.forEach((g) => g.classList.toggle('is-on', Number(g.dataset.s) <= n));
      steps.forEach((s) => s.classList.toggle('is-active', Number(s.dataset.step) === n));
    };
    scene.classList.add('is-live');
    setStage(1);
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) setStage(Number((e.target as HTMLElement).dataset.step));
      },
      { rootMargin: '-40% 0px -45% 0px' },
    );
    steps.forEach((s) => io.observe(s));
  }
</script>

<style>
  .process {
    position: relative;
    overflow: clip;
    background:
      radial-gradient(700px 500px at 80% 40%, rgb(61 110 168 / 0.35), transparent 60%),
      linear-gradient(rgb(157 187 224 / 0.06) 1px, transparent 1px) 0 0 / 30px 30px,
      linear-gradient(90deg, rgb(157 187 224 / 0.06) 1px, transparent 1px) 0 0 / 30px 30px,
      var(--color-navy-950);
    color: var(--color-text-inverse);
  }
  .process .section-head p {
    color: var(--color-navy-100);
  }
  .process__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .steps {
    display: grid;
    gap: clamp(1.5rem, 1rem + 5vh, 5rem);
    list-style: none;
    margin: 0;
    padding: 0 0 12vh;
  }
  .step {
    display: grid;
    grid-template-columns: 56px 1fr;
    column-gap: var(--space-5);
    align-items: start;
  }
  :global(html.js) .step:not(.is-active) > div {
    opacity: 0.6;
  }
  .step > div {
    transition: opacity 400ms ease;
  }
  .step__num {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    font-family: var(--font-display);
    font-weight: 850;
    font-size: 1.3rem;
    color: var(--color-navy-950);
    background: linear-gradient(150deg, var(--color-sand-50), var(--color-sand-300));
    box-shadow:
      inset 0 2px 1px rgb(255 255 255 / 0.7),
      inset 0 -5px 8px rgb(0 0 0 / 0.15),
      0 12px 18px -10px rgb(0 0 0 / 0.6);
    transition:
      transform 450ms var(--ease-spring),
      background 300ms ease;
  }
  .step.is-active .step__num {
    background: linear-gradient(150deg, #ffe6a3, var(--color-sun-400) 60%, #c98200);
    transform: perspective(300px) rotateY(-14deg) scale(1.08);
  }
  .step h3 {
    font-size: var(--text-xl);
    font-weight: 800;
  }
  .step p {
    margin-top: var(--space-2);
    color: var(--color-navy-100);
  }

  .process__scene {
    position: sticky;
    top: calc(var(--header-h) + 3vh);
  }
  .iso {
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 40px 40px rgb(0 0 0 / 0.45));
  }
  .g-top {
    fill: #e9dcc2;
  }
  .g-left {
    fill: #b99e74;
  }
  .g-right {
    fill: #8d7553;
  }
  .plan {
    fill: rgb(157 187 224 / 0.25);
    stroke: var(--color-navy-500);
    stroke-width: 2;
    stroke-dasharray: 7 6;
  }
  .c-top {
    fill: #c7ccd2;
  }
  .c-left {
    fill: #9aa2ab;
  }
  .c-right {
    fill: #7a838d;
  }
  .dim {
    stroke: var(--color-sun-400);
    stroke-width: 2;
    stroke-dasharray: 2 5;
  }
  .w-left {
    fill: #f7efe1;
  }
  .w-right {
    fill: #dccbb0;
  }
  .win {
    fill: var(--color-navy-700);
    stroke: #fff;
    stroke-width: 2;
    transition: fill 600ms ease 400ms;
  }
  [data-stage='5'] .win {
    fill: var(--color-sun-300);
  }
  .door {
    fill: var(--color-green-600);
  }
  .wire {
    fill: none;
    stroke: var(--color-coral-500);
    stroke-width: 3.5;
    stroke-linejoin: round;
  }
  .pipe {
    fill: none;
    stroke: var(--color-green-500);
    stroke-width: 5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .r-front {
    fill: var(--color-coral-500);
  }
  .r-back {
    fill: var(--color-coral-700);
  }
  .r-edge {
    fill: var(--color-coral-800);
  }
  .gable {
    fill: #cdb995;
  }
  .ch-top {
    fill: #f08a73;
  }
  .ch-left {
    fill: var(--color-coral-600);
  }
  .ch-right {
    fill: var(--color-coral-800);
  }
  .trunk {
    fill: #7a5636;
  }
  .leaf {
    fill: var(--color-green-500);
  }
  .leaf-hi {
    fill: var(--color-green-300);
    opacity: 0.7;
  }
  .pin-body {
    fill: var(--color-coral-500);
    stroke: #fff;
    stroke-width: 3;
  }
  .pin-icon {
    fill: #fff;
  }
  .doc-paper {
    fill: #fff;
  }
  .doc-lines {
    stroke: var(--color-navy-300);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .doc-check-bg {
    fill: var(--color-green-500);
  }
  .doc-check {
    fill: none;
    stroke: #fff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Montaje: cada grupo cae a su sitio con un pequeño rebote (de abajo arriba) */
  .is-live .iso-g {
    opacity: 0;
    transform: translateY(-46px);
    transition:
      opacity 300ms ease,
      transform 700ms var(--ease-spring);
  }
  .is-live .iso-g.is-on {
    opacity: 1;
    transform: none;
  }
  /* Sin JS solo se ve la casa terminada */
  .iso-pin,
  .iso-doc {
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .is-live[data-stage='1'] .iso-pin,
  .is-live[data-stage='2'] .iso-pin,
  .is-live[data-stage='4'] .iso-doc {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bob {
      animation: pin-bob 1.6s ease-in-out infinite;
    }
  }
  @keyframes pin-bob {
    50% {
      transform: translateY(-8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-live .iso-g {
      transform: none;
      transition: opacity 200ms linear;
    }
  }

  @media (max-width: 900px) {
    .process__inner {
      grid-template-columns: 1fr;
    }
    .process__scene {
      order: -1;
      top: calc(var(--header-h) + 8px);
      z-index: 1;
      width: min(100%, 340px);
      margin-inline: auto;
      padding: var(--space-3);
      border-radius: var(--radius-xl);
      background: rgb(8 24 43 / 0.85);
      box-shadow: var(--shadow-lg);
    }
    .steps {
      padding-bottom: 6vh;
    }
  }
</style>
