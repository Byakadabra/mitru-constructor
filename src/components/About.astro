---
import Icon, { type IconName } from './Icon.astro';
import type { Dict } from '../i18n/es';
import { site } from '../config/site';

interface Props {
  d: Dict;
}
const { d } = Astro.props;
const valueIcons: IconName[] = ['shield', 'timer', 'euro', 'layers'];
const clientIcons: IconName[] = ['user', 'store', 'bed', 'hardhat'];
---

<section id="nosotros" class="section about" aria-labelledby="about-title">
  <div class="container">
    <div class="about__top">
      <div class="about__intro" data-reveal>
        <span class="kicker">{d.about.kicker}</span>
        <h2 id="about-title">{d.about.title}</h2>
        <p class="about__lead">{d.about.lead}</p>
      </div>
      <div class="about__years" data-reveal style="--i:1">
        <p>
          <span class="about__num" aria-hidden="true">
            +<span data-count-to={site.yearsInSector}>{site.yearsInSector}</span>
          </span>
          <span class="visually-hidden">+{site.yearsInSector}</span>
          <span class="about__years-label">{d.about.yearsLabel}</span>
        </p>
        <svg class="about__years-deco" viewBox="0 0 64 52" aria-hidden="true" focusable="false">
          <polyline points="4,35 17,23.5 30,35" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"></polyline>
          <polyline points="19,27 40,8.5 61,27" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"></polyline>
        </svg>
      </div>
    </div>

    <ul class="about__values">
      {
        d.about.values.map((v, i) => (
          <li data-reveal style={`--i:${i}`}>
            <span class="about__value-icon">
              <Icon name={valueIcons[i]} size={26} />
            </span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="about__clients" data-reveal>
      <h3>{d.about.clientsTitle}</h3>
      <ul>
        {
          d.about.clients.map((c, i) => (
            <li>
              <Icon name={clientIcons[i]} size={24} />
              <div>
                <strong>{c.title}</strong>
                <span>{c.text}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // Contador de años al entrar en pantalla (Counter Animation). Sin JS o con movimiento
  // reducido se ve el número final.
  const el = document.querySelector<HTMLElement>('[data-count-to]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce && 'IntersectionObserver' in window) {
    const target = Number(el.dataset.countTo);
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        const start = performance.now();
        const dur = 1400;
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / dur);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        el.textContent = '0';
        requestAnimationFrame(tick);
      },
      { threshold: 0.6 },
    );
    io.observe(el);
  }
</script>

<style>
  .about__top {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .about__intro {
    display: grid;
    gap: var(--space-4);
  }
  .about__intro h2 {
    font-size: var(--text-3xl);
    font-weight: 800;
  }
  .about__lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 40rem;
  }
  .about__years {
    position: relative;
    padding: var(--space-8);
    background: var(--color-brand-strong);
    color: var(--color-white);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .about__years p {
    display: grid;
  }
  .about__num {
    font-family: var(--font-display);
    font-stretch: 120%;
    font-weight: 900;
    font-size: clamp(4.5rem, 3rem + 6vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .about__years-label {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
  }
  .about__years-deco {
    position: absolute;
    right: -10px;
    bottom: -14px;
    width: 180px;
    color: var(--color-white);
    opacity: 0.18;
  }

  .about__values {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .about__values li {
    padding: var(--space-6);
    border-top: 3px solid var(--color-accent);
    background: var(--color-bg-raised);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .about__value-icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
  .about__values h3 {
    font-size: var(--text-lg);
    font-weight: 800;
  }
  .about__values p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .about__clients {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
  }
  .about__clients h3 {
    font-size: var(--text-xl);
    font-weight: 800;
    margin-bottom: var(--space-6);
  }
  .about__clients ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .about__clients li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .about__clients li :global(svg) {
    flex: none;
    color: var(--color-brand-strong);
    margin-top: 2px;
  }
  .about__clients strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
  }
  .about__clients span {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .about__values,
    .about__clients ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .about__top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .about__values,
    .about__clients ul {
      grid-template-columns: 1fr;
    }
  }
</style>
