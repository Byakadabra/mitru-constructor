---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { t, routes, langs, type Lang, type PageKey } from '../i18n';
import { site, telHref } from '../config/site';

interface Props {
  lang: Lang;
  pageKey: PageKey;
  onHome: boolean;
}
const { lang, pageKey, onHome } = Astro.props;
const d = t(lang);
const home = routes[lang].home;
const link = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);

const items = [
  { id: 'servicios', label: d.nav.services },
  { id: 'nosotros', label: d.nav.about },
  { id: 'proceso', label: d.nav.process },
  { id: 'zona', label: d.nav.area },
  { id: 'contacto', label: d.nav.contact },
];
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <Logo href={home} label={`${site.name} — ${d.nav.home}`} />

    <nav class="site-nav" id="site-nav" aria-label={d.nav.mainNav} data-nav>
      <ul class="site-nav__list">
        {
          items.map((it) => (
            <li>
              <a class="site-nav__link" href={link(it.id)} data-spy={onHome ? it.id : undefined}>
                {it.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="site-nav__extra">
        <div class="lang-switch" role="group" aria-label={d.nav.language}>
          <Icon name="globe" class="lang-switch__icon" size={18} />
          {
            langs.map((l) => (
              <a
                href={routes[l][pageKey]}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? 'true' : undefined}
                title={t(l).langName}
              >
                {l.toUpperCase()}
                <span class="visually-hidden"> — {t(l).langName}</span>
              </a>
            ))
          }
        </div>
        <a class="site-nav__phone" href={telHref}>
          <Icon name="phone" size={18} />
          <span>{site.contact.phoneDisplay}</span>
        </a>
      </div>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn-primary btn-sm site-header__cta" href={link('contacto')}>{d.nav.cta}</a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu-toggle
        data-label-open={d.nav.menuOpen}
        data-label-close={d.nav.menuClose}
        hidden
      >
        <span class="visually-hidden" data-menu-label>{d.nav.menuOpen}</span>
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  // Estado "scrolled": fondo sólido y sombra al desplazarse.
  if (header) {
    let ticking = false;
    const update = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  // Menú móvil: el botón solo existe con JS; sin JS la navegación se muestra en línea.
  if (toggle && nav && header) {
    toggle.hidden = false;
    const mq = window.matchMedia('(max-width: 1199px)');
    const setOpen = (open: boolean) => {
      header.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!;
      document.documentElement.classList.toggle('scroll-lock', open);
      if (open) nav.querySelector<HTMLAnchorElement>('a')?.focus();
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a') && mq.matches) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('menu-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    mq.addEventListener('change', () => setOpen(false));
  }

  // Resaltar la sección visible en el menú (scrollspy).
  const spyLinks = document.querySelectorAll<HTMLAnchorElement>('[data-spy]');
  if (spyLinks.length && 'IntersectionObserver' in window) {
    const byId = new Map([...spyLinks].map((a) => [a.dataset.spy!, a]));
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          spyLinks.forEach((a) => a.classList.remove('is-active'));
          byId.get(entry.target.id)?.classList.add('is-active');
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--header-bg);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--duration-base) ease,
      background-color var(--duration-base) ease;
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--color-border);
    background: rgb(252 251 248 / 0.94);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: var(--header-h);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-left: auto;
  }
  .site-nav__list {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.7rem;
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    text-decoration: none;
    color: var(--color-text);
    border-radius: var(--radius-sm);
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 8px;
    height: 2px;
    background: var(--color-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .site-nav__link:hover::after,
  .site-nav__link:focus-visible::after,
  .site-nav__link.is-active::after {
    transform: scaleX(1);
  }
  .site-nav__extra {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: var(--color-text-muted);
  }
  .lang-switch :global(.lang-switch__icon) {
    margin-right: 4px;
  }
  .lang-switch a {
    display: inline-grid;
    place-items: center;
    min-width: 34px;
    min-height: 34px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }
  .lang-switch a:hover {
    color: var(--color-text);
    background: var(--color-bg-sunken);
  }
  .lang-switch a[aria-current='true'] {
    color: var(--color-white);
    background: var(--color-ink-900);
  }
  .site-nav__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    color: var(--color-accent-strong);
    font-variant-numeric: tabular-nums;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .menu-toggle {
    display: none;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    cursor: pointer;
  }
  .menu-toggle__bars {
    display: grid;
    gap: 5px;
  }
  .menu-toggle__bars span {
    display: block;
    width: 24px;
    height: 2.5px;
    border-radius: 2px;
    background: var(--color-ink-900);
    transition:
      transform var(--duration-base) var(--ease-out),
      opacity var(--duration-fast) ease;
  }
  .menu-open .menu-toggle__bars span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  .menu-open .menu-toggle__bars span:nth-child(2) {
    opacity: 0;
  }
  .menu-open .menu-toggle__bars span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  .site-header__cta {
    white-space: nowrap;
  }
  @media (max-width: 1380px) {
    .site-nav__phone {
      display: none;
    }
  }

  @media (max-width: 1199px) {
    /* backdrop-filter crearía un bloque contenedor para el panel fijo del menú. */
    .site-header,
    .site-header.is-scrolled {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: var(--color-sand-50);
    }
    .site-header__inner {
      gap: var(--space-3);
    }
    /* Sin JS: navegación en una fila desplazable. */
    :global(html:not(.js)) .site-header__inner {
      flex-wrap: wrap;
    }
    :global(html:not(.js)) .site-nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      padding-bottom: var(--space-2);
    }
    /* Con JS: panel desplegable. */
    :global(html.js) .menu-toggle:not([hidden]) {
      display: grid;
    }
    :global(html.js) .site-nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      z-index: var(--z-menu);
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-6);
      margin: 0;
      padding: var(--space-6) var(--gutter) calc(var(--space-12) + env(safe-area-inset-bottom));
      background: var(--color-sand-50);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity var(--duration-base) ease,
        transform var(--duration-base) var(--ease-out),
        visibility 0s linear var(--duration-base);
    }
    :global(html.js) .menu-open .site-nav {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity var(--duration-base) ease,
        transform var(--duration-base) var(--ease-out);
    }
    :global(html.js) .site-nav__list {
      flex-direction: column;
      gap: 0;
    }
    :global(html.js) .site-nav__link {
      width: 100%;
      min-height: 56px;
      padding: 0;
      font-family: var(--font-display);
      font-stretch: 110%;
      font-size: 1.6rem;
      font-weight: 800;
      border-bottom: 1px solid var(--color-border);
      border-radius: 0;
    }
    :global(html.js) .site-nav__link::after {
      display: none;
    }
    :global(html.js) .site-nav__extra {
      flex-direction: column;
      align-items: flex-start;
    }
    :global(html.js) .site-nav__phone {
      display: inline-flex;
      font-size: 1.15rem;
    }
    .lang-switch a {
      min-width: 44px;
      min-height: 44px;
    }
  }

  @media (max-width: 520px) {
    .site-header__cta {
      display: none;
    }
  }
</style>
