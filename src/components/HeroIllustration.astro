---
/**
 * Ilustración del hero: plano de una casa (colores del logo) con la instalación eléctrica
 * y la fontanería trazándose solas — técnica "SVG Path Animation" (Animation Handbook).
 * Animación 100 % CSS con pathLength="1": no necesita JS; con movimiento reducido se muestra completa.
 */
import type { Dict } from '../i18n/es';
interface Props {
  d: Dict;
}
const { d } = Astro.props;
---

<figure class="illo" aria-label={d.hero.illoLabel} role="img">
  <svg viewBox="0 0 560 480" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M20 0H0V20" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.18"></path>
      </pattern>
      <linearGradient id="glow" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffd27a" stop-opacity="0.9"></stop>
        <stop offset="1" stop-color="#ffd27a" stop-opacity="0"></stop>
      </linearGradient>
    </defs>

    <!-- Papel de plano -->
    <rect class="illo__paper" x="10" y="10" width="540" height="460" rx="22"></rect>
    <rect x="10" y="10" width="540" height="460" rx="22" fill="url(#grid)" class="illo__grid"></rect>

    <!-- Cotas -->
    <g class="illo__dim">
      <path class="draw" style="--d:1.9s" pathLength="1" d="M92 438H468"></path>
      <path class="draw" style="--d:1.9s" pathLength="1" d="M92 430v16M468 430v16"></path>
      <path class="draw" style="--d:2s" pathLength="1" d="M496 210V410"></path>
      <path class="draw" style="--d:2s" pathLength="1" d="M488 210h16M488 410h16"></path>
    </g>

    <!-- Estructura de la casa -->
    <g class="illo__walls">
      <path class="draw" style="--d:.15s" pathLength="1" d="M100 410V214H460V410Z"></path>
      <path class="draw" style="--d:.55s" pathLength="1" d="M280 214V410"></path>
      <path class="draw" style="--d:.65s" pathLength="1" d="M100 312H280"></path>
      <path class="draw" style="--d:.8s" pathLength="1" d="M345 410V322H405V410"></path>
      <path class="draw" style="--d:.9s" pathLength="1" d="M330 250H430V295H330Z"></path>
    </g>

    <!-- Tejado (naranja del logo) + chimenea -->
    <path class="illo__chimney fill-in" style="--d:1.15s" d="M392 98h30v66l-30-24Z"></path>
    <path
      class="illo__roof draw"
      style="--d:.35s"
      pathLength="1"
      d="M70 222 280 64 490 222"></path>

    <!-- Pladur: placas -->
    <g class="illo__panels">
      <path class="draw" style="--d:1.1s" pathLength="1" d="M300 330V400M315 330V400"></path>
    </g>

    <!-- Instalación eléctrica: cuadro → enchufes y punto de luz -->
    <g class="illo__electric">
      <rect class="fill-in" style="--d:1.05s" x="116" y="232" width="34" height="44" rx="4"></rect>
      <path
        class="draw"
        style="--d:1.25s"
        pathLength="1"
        d="M150 246H236V264M150 262H196V292"></path>
      <path class="draw" style="--d:1.45s" pathLength="1" d="M150 270H128V340H172"></path>
      <circle class="fill-in" style="--d:1.75s" cx="236" cy="276" r="11"></circle>
      <circle class="fill-in" style="--d:1.8s" cx="196" cy="300" r="7"></circle>
      <circle class="fill-in" style="--d:1.85s" cx="180" cy="340" r="7"></circle>
      <path class="illo__bolt fill-in" style="--d:1.2s" d="M135 238 125 256h8l-3 14 11-19h-8l4-13z"></path>
    </g>
    <ellipse class="illo__light" cx="236" cy="300" rx="34" ry="30" fill="url(#glow)"></ellipse>

    <!-- Fontanería (verde del logo): tubería → grifo y ducha -->
    <g class="illo__water">
      <path class="draw" style="--d:1.3s" pathLength="1" d="M100 392H210V364H252"></path>
      <path class="draw" style="--d:1.55s" pathLength="1" d="M210 392H262V346"></path>
      <path class="draw" style="--d:1.7s" pathLength="1" d="M252 364c10 0 14 6 14 14"></path>
      <path class="draw" style="--d:1.8s" pathLength="1" d="M248 346h28"></path>
      <path class="illo__drop fill-in" style="--d:2.1s" d="M266 384c3 4 5 7 5 9a5 5 0 0 1-10 0c0-2 2-5 5-9Z"></path>
    </g>

    <!-- Rodillo de pintura -->
    <g class="illo__paint">
      <rect class="fill-in" style="--d:1.6s" x="350" y="258" width="60" height="14" rx="4"></rect>
      <path class="draw" style="--d:1.7s" pathLength="1" d="M410 265h10v18h-40v12"></path>
    </g>
  </svg>

  <ul class="illo__tags" aria-hidden="true">
    <li class="illo__tag illo__tag--electric" style="--d:2.2s">{d.hero.tags.electric}</li>
    <li class="illo__tag illo__tag--water" style="--d:2.35s">{d.hero.tags.water}</li>
    <li class="illo__tag illo__tag--wall" style="--d:2.5s">{d.hero.tags.wall}</li>
    <li class="illo__tag illo__tag--paint" style="--d:2.65s">{d.hero.tags.paint}</li>
  </ul>
</figure>

<style>
  .illo {
    position: relative;
    margin: 0;
    color: var(--color-ink-700);
  }
  .illo svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .illo__paper {
    fill: var(--color-white);
    stroke: var(--color-border);
  }
  .illo__walls path {
    fill: none;
    stroke: var(--color-ink-900);
    stroke-width: 3.5;
    stroke-linejoin: round;
  }
  .illo__dim path {
    fill: none;
    stroke: var(--color-ink-400);
    stroke-width: 1.5;
  }
  .illo__roof {
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 22;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .illo__chimney {
    fill: var(--color-brand);
  }
  .illo__panels path {
    fill: none;
    stroke: var(--color-ink-400);
    stroke-width: 2;
    stroke-dasharray: none;
  }
  .illo__electric path {
    fill: none;
    stroke: var(--color-brand-strong);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .illo__electric rect,
  .illo__electric circle {
    fill: var(--color-white);
    stroke: var(--color-brand-strong);
    stroke-width: 3;
  }
  .illo__electric .illo__bolt {
    fill: var(--color-brand);
    stroke: none;
  }
  .illo__water path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .illo__water .illo__drop {
    fill: var(--color-accent);
    stroke: none;
  }
  .illo__paint rect {
    fill: var(--color-accent-tint);
    stroke: var(--color-accent-strong);
    stroke-width: 2.5;
  }
  .illo__paint path {
    fill: none;
    stroke: var(--color-accent-strong);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .illo__light {
    opacity: 0;
  }

  /* Etiquetas de servicios sobre el plano */
  .illo__tags {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .illo__tag {
    position: absolute;
    padding: 0.35rem 0.7rem;
    font-family: var(--font-display);
    font-size: clamp(0.7rem, 0.6rem + 0.3vw, 0.85rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    border-radius: var(--radius-full);
    background: var(--color-ink-900);
    color: var(--color-white);
    box-shadow: var(--shadow-md);
    white-space: nowrap;
  }
  .illo__tag--electric {
    left: 2%;
    top: 37%;
    background: var(--color-brand-strong);
  }
  .illo__tag--water {
    left: 9%;
    bottom: 8%;
    background: var(--color-accent-strong);
  }
  .illo__tag--wall {
    right: 30%;
    bottom: 22%;
  }
  .illo__tag--paint {
    right: 2%;
    top: 40%;
    background: var(--color-white);
    color: var(--color-ink-900);
    border: 1px solid var(--color-border);
  }

  /* ── Animación de entrada (sin JS) ── */
  @media (prefers-reduced-motion: no-preference) {
    .draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 900ms var(--ease-out) var(--d, 0s) forwards;
    }
    .illo__roof.draw {
      animation-duration: 1100ms;
    }
    .fill-in {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: center;
      animation: pop 420ms var(--ease-out) var(--d, 0s) forwards;
    }
    .illo__tag {
      opacity: 0;
      animation: tag-in 500ms var(--ease-out) var(--d, 0s) forwards;
    }
    .illo__light {
      animation: light 1.6s ease-out 2.1s forwards;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .illo__light {
      opacity: 0.8;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes tag-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes light {
    0% {
      opacity: 0;
    }
    35% {
      opacity: 1;
    }
    100% {
      opacity: 0.8;
    }
  }

  @media (max-width: 520px) {
    .illo__tag--wall {
      display: none;
    }
  }
</style>
