---
import { site } from '../config/site';

interface Props {
  href: string;
  label: string;
  inverse?: boolean;
}
const { href, label, inverse = false } = Astro.props;
---

<a class:list={['logo', { 'logo--inverse': inverse }]} href={href} aria-label={label}>
  <img class="logo__mark" src="/img/logo-mark-3d.webp" alt="" width="240" height="170" decoding="async" />
  <span class="logo__text" aria-hidden="true">
    <span class="logo__word">{site.logoWord}</span>
    <span class="logo__sub">{site.logoSub}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    border-radius: var(--radius-sm);
    perspective: 500px;
  }
  .logo__mark {
    width: 68px;
    height: auto;
    flex: none;
    margin-block: -6px;
    transition: transform 450ms var(--ease-spring);
  }
  @media (hover: hover) and (pointer: fine) {
    .logo:hover .logo__mark {
      transform: rotateY(-18deg) translateY(-2px) scale(1.04);
    }
  }
  .logo__text {
    display: grid;
    line-height: 1;
  }
  /* Rótulo con relieve (letra con remates, como el original) */
  .logo__word {
    font-family: var(--font-family-logo);
    font-weight: 900;
    font-size: 1.55rem;
    letter-spacing: 0.02em;
    color: var(--color-green-600);
    text-shadow:
      0 1px 0 var(--color-green-700),
      0 2px 0 var(--color-green-800),
      0 3px 0 var(--color-green-800),
      0 6px 10px rgb(8 24 43 / 0.2);
  }
  .logo__sub {
    font-family: var(--font-family-logo);
    font-weight: 800;
    font-size: 0.66rem;
    letter-spacing: 0.3em;
    color: var(--color-coral-700);
    margin-top: 5px;
  }
  .logo--inverse .logo__word {
    color: var(--color-green-300);
    text-shadow:
      0 1px 0 var(--color-green-600),
      0 2px 0 var(--color-green-700),
      0 3px 0 var(--color-green-800),
      0 6px 12px rgb(0 0 0 / 0.4);
  }
  .logo--inverse .logo__sub {
    color: var(--color-coral-300);
  }
</style>
